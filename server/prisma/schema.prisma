generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int    @id @default(autoincrement())
  username      String @unique
  password_hash String

  items Item[]
  collections Collection[]
  timers Timer[]
  
  @@map(name: "users")
}

model Collection {
  id         Int      @id @default(autoincrement())
  userId     Int
  title      String
  createdAt  DateTime @default(now()) @map("created_at")
  editedAt   DateTime @updatedAt @map("edited_at")
  user       User     @relation(fields: [userId], references: [id])
  items      Item[]
  timers     Timer[]
  
  @@map(name: "collections")
}

enum ItemType {
  todo
  note
}

model Item {
  id              Int       @id @default(autoincrement())
  userId          Int
  collectionId    Int
  parentItemId    Int?
  title           String
  type            ItemType
  isDone          Boolean?
  description     String?
  priority        Int?
  durationPlanned BigInt?
  durationReal    BigInt?
  tags            String[]
  date            DateTime?
  deadline        DateTime?
  showSubItems    Boolean?
  createdAt       DateTime   @default(now()) @map("created_at")
  editedAt        DateTime   @updatedAt @map("edited_at")

  user            User       @relation(fields: [userId], references: [id])
  collection      Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  parentItem      Item?      @relation("ItemToSubItems", fields: [parentItemId], references: [id])
  subItems        Item[]     @relation("ItemToSubItems")
  timer           Timer? @relation("ItemToItemTimer")

  @@map(name: "items")
}

model Timer {
  id              Int       @id @default(autoincrement())
  userId          Int       @map("user_id")
  collectionId    Int       @map("collection_id")
  itemId          Int       @unique @map("item_id")
  startTime       BigInt?   @map("start_time")
  trackedDuration BigInt    @default(0) @map("tracked_duration")
  isRunning       Boolean   @default(false) @map("is_running")
  user            User      @relation(fields: [userId], references: [id])
  collection      Collection @relation(fields: [collectionId], references: [id])
  item            Item      @relation("ItemToItemTimer", fields: [itemId], references: [id], onDelete: Cascade)

  @@map(name: "timers")
}
